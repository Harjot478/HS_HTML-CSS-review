  <main id="main" role="main">
    <!-- HERO / HOME SECTION -->
    <section id="home" class="hero container">
      <div class="hero-content">
        <img src="assets/profile.png" alt="Profile picture of Harjot Singh" class="avatar">
        <div class="hero-text">
          <h2 class="title">Hi, I'm <strong>Harjot Singh</strong></h2>
          <p class="subtitle">Game Designer & Developer | Creating engaging, meaningful games that educate and inspire</p>
          <p class="tagline">Passionate about combining creativity with technology using Unity, C#, and industry-standard design practices</p>
          <p class="cta"><a href="#game-design" class="btn">Explore My Work →</a></p>
        </div>
      </div>
